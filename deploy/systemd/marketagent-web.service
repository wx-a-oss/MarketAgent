[Unit]
Description=MarketAgent web server
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/MarketAgent
EnvironmentFile=/etc/marketagent/marketagent.env
ExecStart=/home/ec2-user/miniconda3/bin/conda run --no-capture-output -n market_agent_env uvicorn frontend.web.server:app --host 0.0.0.0 --port 8000 --log-level info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
